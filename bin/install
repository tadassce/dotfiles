#!/bin/bash

# Install script for a fresh macOS install.
# Before:
# - Install 1P and XCode from the MAS
# - Wait for iCloud Drive to sync

# Verify XCode installed
if ! command -v xcodebuild &> /dev/null; then
  echo "Please install XCode from the App Store"
  exit 1
fi

# Set up dotfiles
if [ ! -d ~/.dotfiles ]; then
  git clone https://github.com/tadassce/dotfiles.git ~/.dotfiles
fi

# Install Homebrew
if command -v brew &> /dev/null; then
  brew update
else
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  brew analytics off
fi

brew bundle check --file ~/.dotfiles/Brewfile || brew bundle --file ~/.dotfiles/Brewfile

# Runtimes (mise picks versions up per project; these are the global fallbacks)
mise use --global ruby@latest node@latest python@latest

# -------------------------------------------------------------------
# Symlink dotfiles

dots=(
  agignore
  aliases
  bin
  completions
  digrc
  fzfrc
  gemrc
  gitattributes
  gitconfig
  gitignore_global
  gitmessage
  gvimrc
  inputrc
  prompt
  tmux.conf
  vimrc
  zsh
  zshrc
)

for dot in "${dots[@]}"
do
  ln -sfn "$HOME/.dotfiles/$dot" "$HOME/.$dot"
done

[ ! -L ~/.icloud ] && ln -s ~/Library/Mobile\ Documents/com\~apple\~CloudDocs ~/.icloud
[ ! -L ~/.config ] && ln -s ~/.icloud/Config ~/.config

ln -sfn "$HOME/.dotfiles/nvim" "$HOME/.config/nvim"

# Only the config file: herdr keeps sockets, logs and session.json here too.
mkdir -p "$HOME/.config/herdr"
ln -sf "$HOME/.dotfiles/herdr/config.toml" "$HOME/.config/herdr/config.toml"

mkdir -p "$HOME/.pi/agent/extensions"
ln -sf "$HOME/.dotfiles/pi/extensions/tmux-window-status.ts" "$HOME/.pi/agent/extensions/tmux-window-status.ts"

# Ghostty: config plus the custom app icon it references.
mkdir -p "$HOME/.config/ghostty"
ln -sf "$HOME/.dotfiles/ghostty/config" "$HOME/.config/ghostty/config"
ln -sfn "$HOME/.dotfiles/ghostty/icons" "$HOME/.config/ghostty/icons"

# Per-host Ghostty overrides: "TS-Mac-mini" -> ghostty/config.mini, the same
# short host name the prompt and herdr/remote-window use. The link lives in
# $HOME because ~/.config is an iCloud symlink and would sync it everywhere.
host=$(hostname -s)
host=$(printf '%s' "${host##*-}" | tr '[:upper:]' '[:lower:]')
if [ -f "$HOME/.dotfiles/ghostty/config.$host" ]; then
  ln -sfn "$HOME/.dotfiles/ghostty/config.$host" "$HOME/.ghostty_local"
elif [ -L "$HOME/.ghostty_local" ]; then
  rm -f "$HOME/.ghostty_local"  # stale link from a previous host
fi

# The macOS app bundle does not put the `ghostty` CLI on PATH; only shells
# started inside Ghostty get it via shell integration.
ghostty_bin="/Applications/Ghostty.app/Contents/MacOS/ghostty"
if [ -x "$ghostty_bin" ]; then
  mkdir -p "$HOME/.local/bin"
  ln -sf "$ghostty_bin" "$HOME/.local/bin/ghostty"
fi

touch ~/.private_aliases
touch ~/.private_profile
touch ~/.tmux_local.conf

# Set the default shell (and in Users' prefs)
# TODO: check if $SHELL ends with /zsh
# chsh -s $(brew --prefix)/bin/zsh

# -------------------------------------------------------------------

# Neovim plugins (lazy.nvim bootstraps itself from nvim/lua/user/plugins.lua)
nvim --headless "+Lazy! sync" +qa

# Tmux Plugin Manager
if [ ! -d ~/.tmux/plugins/tpm ]; then
  git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
fi

# Set some macOS defaults
~/.dotfiles/macos-defaults

# Enable key repeat in VS Code
defaults write com.microsoft.VSCode ApplePressAndHoldEnabled -bool false

echo Done.
