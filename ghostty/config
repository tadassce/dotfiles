# vim: ft=config

font-family = "JetBrains Mono"
font-size = 16
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
macos-icon = custom
macos-custom-icon = ~/.config/ghostty/icons/catppuccin-mocha.icns
title = " "

# Defaults
# ghostty +show-config --default --docs | vim -

# Keyboard shortcuts
# cmd+shift+, - reload config

# Terminal bell behavior: macOS alert sound, Dock attention bounce, and title marker (enable notifications in system preferences for Ghostty)
bell-features = system,attention,title

# Notify when commands run for at least 3s and finish while the surface is unfocused
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 3s

keybind = super+y=copy_url_to_clipboard

# Per-host overrides, kept last so they win whichever way Ghostty orders an
# include. `install` links this to ghostty/config.<host> when that file exists.
# It lives in $HOME rather than next to this config because ~/.config is an
# iCloud symlink, and anything in there would sync to every machine. The ?
# makes it optional, so hosts without an override file load nothing.
config-file = ?~/.ghostty_local
