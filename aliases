#!/bin/zsh

alias l='ls -1'
alias ll='ls -lahG'
alias lt='ls -lahG -snew | tail'

# Git
alias g='git'
alias gb='git br'
alias gu='git pull'
alias gp='git push'
alias gpf='git push --force-with-lease'
alias gpp='gu && gp'
alias gs='git status -sb'
alias gr='git remote -v'
alias gl='git l'
alias glg='git lg'
alias gw="git show"
alias gd='git diff -b'
alias gdc='git diff --cached'
alias gap='git add --intent-to-add . && git add -p'  # Like "git add -p" but also ask about any newly added files.
alias gm='git merge'

alias vim='nvim'
alias tm='tmux -u attach || tmux -u new'
alias ..='cd ..'

# Dev
alias bi='bundle install'
alias bu='bundle update'
alias be='bundle exec'
alias h='herdr'

# macOS
if [[ `uname -s` == 'Darwin' ]]; then
  alias bs='brew services'
  alias brewupd="brew update && echo \"$fg[blue]==>$reset_color Outdated\" && brew outdated"
  alias brewupg="brew upgrade && brew cleanup"
  # Must be an alias, not a symlink: the binary needs its bundle context.
  alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
  alias updates='softwareupdate -l && echo "==> Homebrew" && brew update && brew outdated --greedy'
fi
