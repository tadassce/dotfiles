#!/bin/zsh

setopt promptsubst
autoload -Uz add-zsh-hook

# colour for the NORMAL indicator.
# Set HOST_LABEL in ~/.private_profile; LocalHostName is the fallback.
# Avoid $HOST, which macOS may take from the current network.
host=${HOST_LABEL:-${(L)${$(scutil --get LocalHostName)##*-}}}
case $host in
  mini) host_color=yellow  ;;
  air)  host_color=magenta ;;
  *)    host_color=blue    ;;
esac

# Branch name, green when the tree is clean and magenta when it is dirty.
#
# One `git status` yields both the branch and the dirty flag, and precmd caches
# the result into $git_prompt so redraws are free - the prompt is redrawn on
# every vi mode switch, which would otherwise re-run git on each Esc.
git_prompt=''
_git_prompt() {
  git_prompt=''

  # Cheap pure-zsh repo check: a fork costs ~5ms, these stats cost nothing.
  local dir=$PWD
  until [[ -e $dir/.git ]]; do
    [[ $dir == / ]] && return
    dir=${dir:h}
  done

  local line ref='' oid='' color=green
  for line in ${(f)"$(git --no-optional-locks status --porcelain=v2 --branch 2>/dev/null)"}; do
    case $line in
      '# branch.head '*) ref=${line#'# branch.head '} ;;
      '# branch.oid '*)  oid=${line#'# branch.oid '}  ;;
      '#'*)                                           ;;
      *)                 color=magenta; break         ;; # any entry means dirty
    esac
  done

  [[ $ref == '(detached)' ]] && ref=${oid[1,7]}
  [[ -n $ref ]] && git_prompt="%F{$color}${ref//\%/%%}%f "
}
add-zsh-hook precmd _git_prompt

# NORMAL indicator on the right, in the host colour, while in vi command mode.
vim_prompt="%B%F{$host_color}[NORMAL]%f%b"
function zle-line-init zle-keymap-select {
  RPS1=${${KEYMAP/vicmd/$vim_prompt}/(main|viins)/}
  zle reset-prompt
}
zle -N zle-line-init
zle -N zle-keymap-select

PROMPT="🍊 %F{yellow}%c%f "'${git_prompt}'"%(?.%F{green}.%F{red})%%%f "
