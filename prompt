#!/bin/zsh

setopt promptsubst

# Machine name: "TS-MacBook-Air.local" -> "air". Each machine gets its own
# colour so it is obvious at a glance which one a terminal is on.
host=${(L)${${HOST%%.*}##*-}}
case $host in
  mini) host_color=yellow ;;
  *)    host_color=cyan   ;;
esac

# Branch name, green when the tree is clean and magenta when it is dirty.
git_br() {
  local ref
  ref=$(git symbolic-ref --short HEAD 2>/dev/null) ||
    ref=$(git rev-parse --short HEAD 2>/dev/null) || return
  if [[ -n $(git status --porcelain 2>/dev/null) ]]; then
    print -n "%F{magenta}$ref%f "
  else
    print -n "%F{green}$ref%f "
  fi
}

# NORMAL indicator on the right, in the host colour, while in vi command mode.
vim_prompt="%B%F{$host_color}[NORMAL]%f%b"
function zle-line-init zle-keymap-select {
  RPS1=${${KEYMAP/vicmd/$vim_prompt}/(main|viins)/}
  zle reset-prompt
}
zle -N zle-line-init
zle -N zle-keymap-select

# host:dir branch %   - the % turns red when the last command failed.
PROMPT="%F{$host_color}$host%f:%F{green}%c%f \$(git_br)%(?.%F{green}.%F{red})%%%f "
