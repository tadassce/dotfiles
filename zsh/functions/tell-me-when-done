#!/bin/zsh

# Given a long-running process in the terminal:
#
# - Ctrl+Z to suspend it
# - Run `tell-me-when-done`
# - Output resumes, when done will show a notification

function tell-me-when-done() {
  last_command=$(history | tail -1 | cut -d' ' -f3-)
  sound=/System/Library/PrivateFrameworks/ToneLibrary.framework/Versions/A/Resources/AlertTones/EncoreInfinitum/Handoff-EncoreInfinitum.caf

  fg && osascript -e "display notification \"$last_command\" with title \"Done\"" && afplay $sound
}
